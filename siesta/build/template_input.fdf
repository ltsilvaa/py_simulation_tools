# ==============================================================================
# Input altomatically generated from the .yaml file
# ==============================================================================

# --- Name --- 
SystemName          {{ SystemName | default('siesta') }}
SystemLabel         {{ SystemLabel | default('siesta') }}

# --- Numbers ---
NumberOfAtoms       {{ NumberOfAtoms }}
NumberOfSpecies     {{ NumberOfSpecies | length }}

# --- Labels ---
%block ChemicalSpeciesLabel
{% for s in Species -%}
   {{ s.Id }}  {{ s.Z }}  {{ s.Symbol }}
{%- endfor %}
%endblock ChemicalSpeciesLabel

# --- PAO Basis ---
PAO.BasisSize       {{ PAO.BasisSize | default(DZP) }}
PAO.EnergyShift     {{ PAO.EnergyShift | default(0.01 Ry) }}

# --- XC Functional ---
XC.functional       {{ XC.functional | default(GGA) }}
XC.authors          {{ XC.authors | default(PBE) }}

# --- SCF ---
SolutionMethod         {{ SolutionMethod | default(Diagon) }}
MaxSCFIterations       {{ MaxSCFIterations | default(1000) }}
ElectronicTemperature  {{ ElectronicTemperature | default(300 K) }}
SCF.Mixer.Method       {{ SCF.Mixer.Method | default(pulay) }}
SCF.Mixer.Weight       {{ SCF.Mixer.Weight | default(0.05) }}
SCF.DM.Tolerance       {{ SCF.DM.Tolerance | default(1d-6) }}

# --- MD ---
MD.TypeOfRun        {{ MD.TypeOfRun | default('CG') }}
MD.steps            {{ MD.steps | default(1000) }}
MD.MaxDispl         {{ MD.MaxDispl | default(0.2 Ang) }} 
MD.UseSaveXV        {{ MD.UseSaveXV | default(false) }}
MD.UseSaveCG        {{ MD.UseSaveCG | default(false) }}
DM.UseSaveDM        {{ MD.UseSaveDM | default(false) }}
UseSaveData         {{ MD.UseSaveData | default(false) }}
MD.MaxForceTol      {{ MD.MaxForceTol | default(0.01 eV/Ang) }}
MD.MaxStressTol     {{ MD.MaxStressTol | default(0.0 GPa) }}

# --- Mesh ---
Mesh.Cutoff         {{ Mesh.Cutoff | default(300 Ry) }}

# --- Charge & Spin ---
NetCharge           {{ NetCharge | default(0) }}
Spin                {{ Spin | default(non-polarized) }}

# --- Kpoints --- 
%block kgrid_Monkhorst_Pack
   {{ kp[0] }}        0          0        0.0
       0         {{ kp[1] }}     0        0.0
       0             0      {{ kp[2] }}   0.0
%endblock kgrid_Monkhorst_Pack

# --- DOS ---
{%if dos_calc == True -%}
%block ProjectedDensityOfStates
    {dos_config | default('-15.00 15.00 0.0500 10000 eV')}
%endblock ProjectedDensityOfStates
 
%block DOS.kgrid_Monkhorst_Pack
   {{ kpdos[0] | default(4*kp[0]) }}        0          0        0.0
       0         {{ kpdos[1] | default(4*kp[1]) }}     0        0.0
       0             0      {{ kpdos[2] | default(4*kp[2]) }}   0.0
%endblock DOS.kgrid_Monkhorst_Pack
{% endif %}

# --- Bands ---
{%if bands_calc == True -%}
BandLinesScale ReciprocalLatticeVectors
%block BandLines
    {band_path}
%endblock BandLines
{% endif %}

# --- Dispersion --- 
DFTD3               {{ DFTD3 | default(false) }}
DFTD3.UseXCDefaults {{ DFTD3.UseXCDefaults | default(false) }}
DFTD3.BJdamping     {{ DFTD3;BJdamping | default(false) }}

# --- Lattice ---
FixAuxiliaryCell   {{ FixAuxiliaryCell | default(false) }}
MD.VariableCell    {{ MD.VariableCell | default(true) }}
%block LatticeVectors
{% for vector in LatticeVectors -%}
    {% for v in vector -%}
        {{ "%10.5f" | format(v) }}
    {%- endfor %}
{% endfor -%}
%endblock LatticeVectors

# --- Geometry ---
AtomicCoordinatesFormat    {{ AtomicCoordinatesFormat | default('Ang') }}
AtomCoorFormatOut          {{ AtomCoorFormatOut | default('Ang') }}
%block AtomicCoordinatesAndAtomicSpecies
{% for atom in Atoms -%}
    {% for cord in atom -%}
        {{ "%10.6f" | format(cord) }}
    {%- endfor %}    
{%- endfor %}
%endblock AtomicCoordinatesAndAtomicSpecies

# --- Constrains ---
{%if constrains == True -%}
    %block GeometryConstraints
    {% for c in GeometryConstraints -%}
        {{ c }}
    {%- endfor %}
    %endblock GeometryConstraints
{% endif %}

# --- Write ---
{% for w in Write -%}
    {{ w }}
{%- endfor %}